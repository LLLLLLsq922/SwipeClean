<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\SwipeClean\Runtime\Domain\*.cs" Link="Domain\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\SwipeClean\Runtime\Application\*.cs" Link="Application\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\SwipeClean\Runtime\Levels\*.cs" Link="Levels\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

